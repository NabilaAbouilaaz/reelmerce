# Postgres connection string (from Neon dashboard -> Connection string, "pooled" is fine)
DATABASE_URL=

# Clerk (Dashboard -> API keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary (Dashboard -> "API Environment variable", format: cloudinary://<key>:<secret>@<cloud_name>)
CLOUDINARY_URL=


# fal.ai API key
FAL_KEY=

# Set to "true" to skip real AI calls and return placeholder media
MOCK_GENERATION=

# Optional: Render sets PORT automatically; defaults to 5000 locally
# PORT=5000
